{
  "info": {
    "_postman_id": "ai-gen-free-collection-v2",
    "name": "ai-gen-free API Collection",
    "description": "Collection Postman resmi untuk testing backend ai-gen-free.\nMencakup registrasi akun, verifikasi email, login password, verifikasi OTP 2FA, rate limiting, reset password, anti-IDOR profil pengguna, wallet customer, generator model Siray (openai/gpt-image-2-t2i), dan manajemen admin (termasuk kontrol poin model).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication & Profile (User)",
      "item": [
        {
          "name": "1.1 Register User Baru (Valid)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user.test123@gmail.com\",\n  \"password\": \"ValidPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/register",
              "host": ["{{baseUrl}}"],
              "path": ["user", "register"]
            },
            "description": "Mendaftar akun baru dengan email whitelist (@gmail.com, @yahoo.com, @ymail.com) dan password minimal 8 karakter (>=1 huruf kapital, >=1 angka)."
          },
          "response": []
        },
        {
          "name": "1.2 Register User (Tolak Domain Palsu/Test)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user.hacker@test.com\",\n  \"password\": \"ValidPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/register",
              "host": ["{{baseUrl}}"],
              "path": ["user", "register"]
            },
            "description": "Uji coba penolakan domain di luar whitelist (@test.com / @mailinator.com). Mengembalikan HTTP 400 dengan error code A010."
          },
          "response": []
        },
        {
          "name": "1.3 Register User (Tolak Password Lemah)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user.weak@gmail.com\",\n  \"password\": \"weak\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/register",
              "host": ["{{baseUrl}}"],
              "path": ["user", "register"]
            },
            "description": "Uji coba penolakan kata sandi di bawah 8 karakter tanpa huruf kapital/angka. Mengembalikan HTTP 400 dengan error code A011."
          },
          "response": []
        },
        {
          "name": "1.4 Verifikasi Email Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{emailVerificationToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/email-validation",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "email-validation"]
            },
            "description": "Memverifikasi token email. Wajib POST JSON body { token }."
          },
          "response": []
        },
        {
          "name": "1.5 Login User (Email + Password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.sessionToken) {",
                  "        pm.environment.set(\"userSessionToken\", json.sessionToken);",
                  "        console.log(\"Auto-saved userSessionToken:\", json.sessionToken);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-device-id",
                "value": "device-browser-chrome-v1"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user.test123@gmail.com\",\n  \"password\": \"ValidPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/login",
              "host": ["{{baseUrl}}"],
              "path": ["user", "login"]
            },
            "description": "Login pelanggan. Jika belum pernah login / ganti perangkat, mengembalikan requiresOtp: true. Mengeset otomatis variable userSessionToken."
          },
          "response": []
        },
        {
          "name": "1.6 Request / Resend OTP (Baru / Ganti Perangkat)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user.test123@gmail.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "otp"]
            },
            "description": "Meminta kode OTP ke email. Terikat rate limit maksimal 3 kali per 30 menit (lockout 30 menit jika dilanggar)."
          },
          "response": []
        },
        {
          "name": "1.7 Validasi OTP 2FA",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.sessionToken) {",
                  "        pm.environment.set(\"userSessionToken\", json.sessionToken);",
                  "        console.log(\"Auto-saved userSessionToken:\", json.sessionToken);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-device-id",
                "value": "device-browser-chrome-v1"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user.test123@gmail.com\",\n  \"code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/otp-validation",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "otp-validation"]
            },
            "description": "Memvalidasi OTP 6 digit. Mengeset otomatis variable userSessionToken."
          },
          "response": []
        },
        {
          "name": "1.8 Ambil Profil Pengguna (Anti-IDOR)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-session-token",
                "value": "{{userSessionToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/profile",
              "host": ["{{baseUrl}}"],
              "path": ["user", "profile"]
            },
            "description": "Mengambil profil pengguna berdasarkan token sesi (bebas celah IDOR)."
          },
          "response": []
        },
        {
          "name": "1.9 Update Profil Pengguna",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-session-token",
                "value": "{{userSessionToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Budi Santoso\",\n  \"phoneNumber\": \"081234567890\",\n  \"address\": \"Jl. Sudirman No. 123, Jakarta\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/profile",
              "host": ["{{baseUrl}}"],
              "path": ["user", "profile"]
            },
            "description": "Memperbarui nama alias, telepon, KTP, atau alamat pengguna."
          },
          "response": []
        },
        {
          "name": "1.10 Request Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user.test123@gmail.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/password-reset",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "password-reset"]
            },
            "description": "Mengirimkan link reset password ke email terdaftar."
          },
          "response": []
        },
        {
          "name": "1.11 Validasi Token Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{passwordResetToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/password-reset-validation",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "password-reset-validation"]
            },
            "description": "Memeriksa apakah token reset password valid dan belum kadaluarsa."
          },
          "response": []
        },
        {
          "name": "1.12 Konfirmasi Reset Password Baru",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{passwordResetToken}}\",\n  \"password\": \"NewPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/password-reset-confirm",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "password-reset-confirm"]
            },
            "description": "Mengubah kata sandi pengguna dengan token reset password valid."
          },
          "response": []
        },
        {
          "name": "1.13 Logout User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-session-token",
                "value": "{{userSessionToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/logout",
              "host": ["{{baseUrl}}"],
              "path": ["user", "logout"]
            },
            "description": "Mencabut sesi login pengguna."
          },
          "response": []
        }
      ]
    },
