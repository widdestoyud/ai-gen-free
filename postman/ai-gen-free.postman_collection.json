    {
      "name": "3. Model Catalog & Generation (User)",
      "item": [
        {
          "name": "3.1 Katalog Model Generator Customer (GET /api/catalog/generate)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-session-token",
                "value": "{{userSessionToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/catalog/generate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "catalog", "generate"]
            },
            "description": "Melihat daftar model generator gambar yang aktif beserta biaya poin resmi dari server."
          },
          "response": []
        },
        {
          "name": "3.2 Submit Job Generator Default (POST /api/jobs)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-session-token",
                "value": "{{userSessionToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "idemp-test-job-001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mode\": \"t2i\",\n  \"prompt\": \"Seekor kucing memakai mahkota raja emas di atas tahta, gaya lukisan minyak cat emas kustom\",\n  \"params\": {\n    \"aspectRatio\": \"1:1\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/jobs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs"]
            },
            "description": "Mengirimkan permintaan generator gambar (202 Accepted + jobId)."
          },
          "response": []
        },
        {
          "name": "3.3 Submit Siray GPT Image 2 (POST /generate/siray/gpt-image-2-t2i)",
          "request": {
            "method": "POST",
