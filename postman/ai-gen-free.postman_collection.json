{
  "info": {
    "_postman_id": "ai-gen-free-collection-v2",
    "name": "ai-gen-free API Collection",
    "description": "Collection Postman resmi untuk testing backend ai-gen-free.\nMencakup registrasi akun, verifikasi email, login password, verifikasi OTP 2FA, rate limiting, anti-IDOR profil pengguna, job generator, dan admin.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication & Profile (User)",
      "item": [
        {
          "name": "1.1 Register User Baru (Valid)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user.test123@gmail.com\",\n  \"password\": \"ValidPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/register",
              "host": ["{{baseUrl}}"],
              "path": ["user", "register"]
            },
            "description": "Mendaftar akun baru dengan email whitelist (@gmail.com, @yahoo.com, @ymail.com) dan password minimal 8 karakter (>=1 huruf kapital, >=1 angka)."
          },
          "response": []
        },
        {
          "name": "1.2 Register User (Tolak Domain Palsu/Test)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user.hacker@test.com\",\n  \"password\": \"ValidPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/register",
              "host": ["{{baseUrl}}"],
              "path": ["user", "register"]
            },
            "description": "Uji coba penolakan domain di luar whitelist (@test.com / @mailinator.com). Harus mengembalikan HTTP 400 dengan error code A010."
          },
          "response": []
        },
        {
          "name": "1.3 Register User (Tolak Password Lemah)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user.weak@gmail.com\",\n  \"password\": \"weak\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/register",
              "host": ["{{baseUrl}}"],
              "path": ["user", "register"]
            },
            "description": "Uji coba penolakan kata sandi di bawah 8 karakter tanpa huruf kapital/angka. Harus mengembalikan HTTP 400 dengan error code A011."
          },
          "response": []
        },
        {
          "name": "1.4 Verifikasi Email Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{emailVerificationToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/email-validation",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "email-validation"]
            },
            "description": "Memverifikasi token email yang dikirim setelah pendaftaran agar status akun menjadi terverifikasi."
          },
          "response": []
        },
        {
          "name": "1.5 Login User (Email & Password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-device-id",
                "value": "device-desktop-chrome-v1"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user.test123@gmail.com\",\n  \"password\": \"ValidPassword123!\",\n  \"deviceId\": \"device-desktop-chrome-v1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/login",
              "host": ["{{baseUrl}}"],
              "path": ["user", "login"]
            },
            "description": "Login menggunakan email dan password. Jika login pertama kali atau terdeteksi ganti perangkat, mengembalikan requiresOtp: true dan mengirim kode OTP ke email."
          },
          "response": []
        },
        {
          "name": "1.6 Request / Resend OTP (Rate Limit Maks 3x / 30 Mins)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user.test123@gmail.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "otp"]
            },
            "description": "Meminta atau mengirim ulang kode OTP ke email terdaftar. Dibatasi maksimal 3x per 30 menit. Percobaan ke-4 akan mengembalikan HTTP 429 (lockout 30 menit)."
          },
          "response": []
        },
        {
          "name": "1.7 Validasi OTP (Perangkat Baru / 2FA)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-device-id",
                "value": "device-desktop-chrome-v1"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user.test123@gmail.com\",\n  \"code\": \"123456\",\n  \"deviceId\": \"device-desktop-chrome-v1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/otp-validation",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "otp-validation"]
            },
            "description": "Validasi kode OTP 6 digit. Jika salah 3x berturut-turut, OTP dikunci permanen (HTTP 429). Jika benar, membuat sesi baru dan mengeset cookie sid."
          },
          "response": []
        },
        {
          "name": "1.8 Ambil Profil User (GET /user/profile)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/profile",
              "host": ["{{baseUrl}}"],
              "path": ["user", "profile"]
            },
            "description": "Melihat data profil pengguna saat ini. Diotentikasi mutlak dari cookie sesi sid."
          },
          "response": []
        },
        {
          "name": "1.9 Update Profil User (PATCH /user/profile - Anti IDOR)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Budi Santoso\",\n  \"phoneNumber\": \"081234567890\",\n  \"ktp\": \"3171012345670001\",\n  \"address\": \"Jl. Merdeka No. 45, Jakarta Pusat\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/profile",
              "host": ["{{baseUrl}}"],
              "path": ["user", "profile"]
            },
            "description": "Memperbarui nama alias, nomor telepon, KTP, dan alamat. Kebal celah IDOR karena identitas diambil dari session.userId server."
          },
          "response": []
        },
        {
          "name": "1.10 Logout User (POST /user/logout)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/logout",
              "host": ["{{baseUrl}}"],
              "path": ["user", "logout"]
            },
            "description": "Keluar dari sistem, menghapus cookie sid, dan mencabut sesi di database."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Wallet & Generation (User)",
      "item": [
        {
          "name": "2.1 Ambil Status Client (GET /api/me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me"]
            },
            "description": "Mengecek informasi identitas user dan timer cooldown generator."
          },
          "response": []
        },
        {
          "name": "2.2 Ambil Saldo Wallet (GET /api/wallet)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/wallet",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wallet"]
            },
            "description": "Melihat poin tersedia (available) dan poin tertahan (held)."
          },
          "response": []
        },
        {
          "name": "2.3 Katalog Model Generator (GET /api/catalog/generate)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/catalog/generate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "catalog", "generate"]
            },
            "description": "Melihat daftar model generator gambar yang aktif beserta biaya poinnya."
          },
          "response": []
        },
        {
          "name": "2.4 Submit Job Generator (POST /api/jobs)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "idemp-test-job-001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mode\": \"t2i\",\n  \"prompt\": \"Seekor kucing memakai mahkota raja emas di atas tahta, gaya lukisan minyak cat emas kustom\",\n  \"params\": {\n    \"aspectRatio\": \"1:1\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/jobs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs"]
            },
            "description": "Mengirimkan permintaan generator gambar (202 Accepted + jobId). Memerlukan Idempotency-Key 8–128 karakter."
          },
          "response": []
        },
        {
          "name": "2.5 Daftar Job Pengguna (GET /api/jobs)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/jobs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs"]
            },
            "description": "Melihat riwayat job generator pengguna."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Admin Management",
      "item": [
        {
          "name": "3.1 Register Admin Baru (Username + Password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin123\",\n  \"password\": \"AdminPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/register",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "register"]
            },
            "description": "Mendaftar akun admin baru menggunakan username dan password (tanpa OTP/verifikasi email)."
          },
          "response": []
        },
        {
          "name": "3.2 Login Admin (Username + Password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-device-id",
                "value": "device-admin-chrome-v1"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin123\",\n  \"password\": \"AdminPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/login",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "login"]
            },
            "description": "Login khusus admin menggunakan username dan password tanpa verifikasi OTP. Mengembalikan sessionToken dan menetapkan cookie sid_admin."
          },
          "response": []
        },
        {
          "name": "3.3 Daftar Customer / User (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "sid_admin={{adminSessionToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/customer/list",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "customer", "list"]
            },
            "description": "Melihat seluruh daftar pengguna customer/user yang terdaftar di platform beserta detail status akun dan saldo poin."
          },
          "response": []
        },
        {
          "name": "3.4 Ambil Pengaturan Cooldown Admin",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "sid_admin={{adminSessionToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/settings/generate_cooldown_seconds",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "settings", "generate_cooldown_seconds"]
            },
            "description": "Melihat durasi cooldown generator dalam detik (default 43200 = 12 jam)."
          },
          "response": []
        },
        {
          "name": "3.5 Ubah Pengaturan Cooldown Admin",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "sid_admin={{adminSessionToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"value\": 3600\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/settings/generate_cooldown_seconds",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "settings", "generate_cooldown_seconds"]
            },
            "description": "Mengubah durasi cooldown generator global (misalnya menjadi 3600 detik = 1 jam)."
          },
          "response": []
        },
        {
          "name": "3.6 Logout Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "sid_admin={{adminSessionToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/logout",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "logout"]
            },
            "description": "Menghapus/mencabut sesi login admin yang sedang aktif dan membersihkan cookie sid_admin."
          },
          "response": []
        }
      ]
    }
  ]
}
