            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Sebuah pemandangan gunung dengan danau jernih di sore hari\",\n  \"n\": 1,\n  \"output_format\": \"png\",\n  \"quality\": \"low\",\n  \"size\": \"1024x768\",\n  \"moderation\": \"auto\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/generate/siray/gpt-image-2-t2i",
              "host": ["{{baseUrl}}"],
              "path": ["generate", "siray", "gpt-image-2-t2i"]
            },
            "description": "Endpoint khusus generate model Siray openai/gpt-image-2-t2i."
          },
          "response": []
        },
