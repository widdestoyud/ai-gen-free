    {
      "name": "generate",
      "item": [
        {
          "name": "POST /jobs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 202) {",
                  "    var json = pm.response.json();",
                  "    if (json.job_id) {",
                  "        pm.environment.set(\"jobId\", json.job_id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-session-token",
                "value": "{{userSessionToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "idemp-test-job-001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mode\": \"t2i\",\n  \"prompt\": \"Seekor kucing memakai mahkota raja emas di atas tahta\",\n  \"params\": {\n    \"aspectRatio\": \"1:1\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/jobs",
              "host": ["{{baseUrl}}"],
              "path": ["jobs"]
            },
            "description": "Submit generate generic (202 + job_id). BFF Next /api/jobs POST di-rewrite ke sini."
          },
          "response": []
        },
