# Salin ke .env. Jangan commit .env.

# Runtime = transaction pooler. Migrate/seed = Direct Connection (bukan 6432).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6432/DBNAME?sslmode=disable&pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:65436/DBNAME?sslmode=disable
REDIS_URL=redis://redis:6379

# Objek: ganti backend hanya STORAGE_DRIVER (r2 | s3 | minio | memory). Bukan edit UI/job.
STORAGE_DRIVER=r2
STORAGE_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
STORAGE_PUBLIC_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=generations
STORAGE_FORCE_PATH_STYLE=false
# MinIO lokal opsional: docker compose --profile minio
# STORAGE_DRIVER=minio STORAGE_ENDPOINT=http://minio:9000 STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
# STORAGE_REGION=us-east-1 STORAGE_ACCESS_KEY=minio STORAGE_SECRET_KEY=minio12345 STORAGE_FORCE_PATH_STYLE=true

# EmailPort = SMTP. Mailpit opsional: docker compose --profile mailpit
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# Hanya service worker. Jangan di web / browser (ADR 0007).
SIRAY_API_TOKEN=
SIRAY_API_BASE=https://api.siray.ai

WORKER_CONCURRENCY=3
APP_PUBLIC_URL=http://localhost:3000
API_URL=http://localhost:4000

# Cookie
SESSION_SECRET=change-me-to-32-bytes-min
# NextAuth (apps/web). Dev: boleh sama dengan SESSION_SECRET.
AUTH_SECRET=change-me-to-32-bytes-min
AUTH_TRUST_HOST=true

# Basic Auth gerbang /admin (bukan login user)
ADMIN_BASIC_USER=admin
ADMIN_BASIC_PASSWORD=change-me

# Email admin yang boleh OTP masuk panel (seed)
ADMIN_EMAILS=you@example.com

# Instruksi QRIS statis (v1: unggah bukti di dashboard, bukan chat)
QRIS_INSTRUCTIONS=Bayar QRIS sesuai nominal invoice, lalu unggah bukti di dashboard. Screenshot chat tidak mengkredit poin.
