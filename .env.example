# Salin ke .env. Jangan commit .env.

DATABASE_URL=postgresql://app:app@postgres:5432/app
REDIS_URL=redis://redis:6379

S3_ENDPOINT=http://minio:9000
# Host yang dipakai browser untuk signed URL (bukan hostname Docker)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=generations
S3_FORCE_PATH_STYLE=true

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@localhost

# Hanya worker (dan api jika katalog butuh). Jangan ke browser.
SIRAY_API_TOKEN=
SIRAY_API_BASE=https://api.siray.ai

WORKER_CONCURRENCY=3
APP_PUBLIC_URL=http://localhost:3000
API_URL=http://localhost:3001

# Cookie
SESSION_SECRET=change-me-to-32-bytes-min

# Basic Auth gerbang /admin (bukan login user)
ADMIN_BASIC_USER=admin
ADMIN_BASIC_PASSWORD=change-me

# Email admin yang boleh OTP masuk panel (seed)
ADMIN_EMAILS=you@example.com

# Instruksi QRIS statis (v1: unggah bukti di dashboard, bukan chat)
QRIS_INSTRUCTIONS=Bayar QRIS sesuai nominal invoice, lalu unggah bukti di dashboard. Screenshot chat tidak mengkredit poin.
