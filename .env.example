# Salin ke .env. Jangan commit .env.

DATABASE_URL=postgresql://app:app@postgres:5432/app
REDIS_URL=redis://redis:6379

# Objek: ganti backend hanya dengan STORAGE_DRIVER (minio | s3 | r2 | memory)
STORAGE_DRIVER=minio
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=minio12345
STORAGE_BUCKET=generations
STORAGE_FORCE_PATH_STYLE=true
# Alias lama S3_* masih dibaca jika STORAGE_* kosong.
# R2: STORAGE_DRIVER=r2 STORAGE_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com STORAGE_REGION=auto STORAGE_FORCE_PATH_STYLE=false

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@localhost

# Hanya worker (dan api jika katalog butuh). Jangan ke browser.
SIRAY_API_TOKEN=
SIRAY_API_BASE=https://api.siray.ai

WORKER_CONCURRENCY=3
APP_PUBLIC_URL=http://localhost:3000
API_URL=http://localhost:3001

# Cookie
SESSION_SECRET=change-me-to-32-bytes-min

# Basic Auth gerbang /admin (bukan login user)
ADMIN_BASIC_USER=admin
ADMIN_BASIC_PASSWORD=change-me

# Email admin yang boleh OTP masuk panel (seed)
ADMIN_EMAILS=you@example.com

# Instruksi QRIS statis (v1: unggah bukti di dashboard, bukan chat)
QRIS_INSTRUCTIONS=Bayar QRIS sesuai nominal invoice, lalu unggah bukti di dashboard. Screenshot chat tidak mengkredit poin.
